import json
import os
import tempfile
import threading
import time
import unittest
import urllib.error
import urllib.request

import backend
from sunsync_core import SiteConfig

def call(port, method, path, body=None, token=None):
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", method=method,
                                 data=None if body is None else json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json", **({"X-Device-Token": token} if token else {})})
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            return r.status, json.loads(r.read())
    except urllib.error.HTTPError as e:
        return e.code, json.loads(e.read())

def start(db=":memory:", token=""):
    srv, site = backend.serve(0, db, token, SiteConfig(site_scale=500))
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv, site, srv.server_address[1]


NOON = dict(device_id="t", v=17.9, i=1.05, temp_c=38.0, lux=100000.0, flags=0)

class BackendTests(unittest.TestCase):
    def test_telemetry_roundtrip_and_status(self):
        srv, site, port = start()
        try:
            code, r = call(port, "POST", "/api/telemetry", dict(NOON, ts=time.time()))
            self.assertEqual(code, 200)
            self.assertTrue(r["ok"] and r["valid"])
            self.assertEqual(len(r["relays"]), 3)
            self.assertEqual(r["relay_order"], ["boiler", "pump", "ev_charger"])
            code, st = call(port, "GET", "/api/status")
            self.assertEqual(code, 200)
            self.assertAlmostEqual(st["reading"]["p"], 17.9 * 1.05, places=2)
            self.assertIn("soc", st["battery"])
        finally:
            srv.shutdown(); srv.server_close()

    def test_invalid_readings_are_flagged_not_crashing(self):
        srv, site, port = start()
        try:
            for bad in (dict(NOON, lux=None), dict(NOON, v=999), {"garbage": 1}, dict(NOON, flags=1)):
                code, r = call(port, "POST", "/api/telemetry", dict(bad, ts=time.time()))
                self.assertEqual(code, 200)
                self.assertFalse(r["valid"])
                self.assertTrue(r["problems"])
                self.assertEqual(r["relays"], [0, 0, 0])      
        finally:
            srv.shutdown(); srv.server_close()

    def test_bad_json_and_unknown_route(self):
        srv, site, port = start()
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{port}/api/telemetry", data=b"{not json", method="POST")
            with self.assertRaises(urllib.error.HTTPError) as cm:
                urllib.request.urlopen(req, timeout=5)
            self.assertEqual(cm.exception.code, 400)
            self.assertEqual(call(port, "GET", "/api/nope")[0], 404)
        finally:
            srv.shutdown(); srv.server_close()

    def test_device_token(self):
        srv, site, port = start(token="s3cret")
        try:
            self.assertEqual(call(port, "POST", "/api/telemetry", dict(NOON, ts=time.time()))[0], 401)
            self.assertEqual(call(port, "POST", "/api/telemetry", dict(NOON, ts=time.time()), token="s3cret")[0], 200)
            self.assertEqual(call(port, "GET", "/api/health")[0], 200)   
        finally:
            srv.shutdown(); srv.server_close()

    def test_unsynced_device_clock_uses_arrival_time(self):
        srv, site, port = start()
        try:
            call(port, "POST", "/api/telemetry", dict(NOON, ts=0))
            self.assertAlmostEqual(site.last.ts, time.time(), delta=5)
        finally:
            srv.shutdown(); srv.server_close()

    def test_relay_override_and_fix(self):
        srv, site, port = start()
        try:
            self.assertEqual(call(port, "POST", "/api/relay", dict(load="pump", mode="on"))[1]["ok"], True)
            code, r = call(port, "POST", "/api/telemetry", dict(NOON, ts=time.time()))
            self.assertEqual(r["relays"][1], 1)
            self.assertFalse(call(port, "POST", "/api/relay", dict(load="nope", mode="on"))[1]["ok"])
            self.assertFalse(call(port, "POST", "/api/relay", dict(load="pump", mode="maybe"))[1]["ok"])
            call(port, "POST", "/api/relay", dict(load="pump", mode="auto"))
            self.assertTrue(call(port, "POST", "/api/fix", dict(code="soiling"))[1]["ok"])
            self.assertEqual(call(port, "GET", "/api/ledger")[1]["summary"]["fixes"], 1)
        finally:
            srv.shutdown(); srv.server_close()

    def test_persistence_survives_restart(self):
        d = tempfile.mkdtemp()
        path = os.path.join(d, "t.db")
        srv, site, port = start(db=path)
        base = time.time()
        for k in range(30):
            call(port, "POST", "/api/telemetry", dict(NOON, ts=base + 10 * k))
        n = len(site.ledger.rows)
        soc = site.battery.soc
        srv.shutdown(); srv.server_close()
        site.db.close()
        srv2, site2, port2 = start(db=path)
        try:
            self.assertEqual(len(site2.ledger.rows), n)
            self.assertAlmostEqual(site2.battery.soc, soc, places=9)
        finally:
            srv2.shutdown(); srv2.server_close()


class CalibrationTests(unittest.TestCase):
    def test_calibrate_endpoint_recovers_k_and_persists(self):
        d = tempfile.mkdtemp()
        path = os.path.join(d, "c.db")
        srv, site, port = start(db=path)
        base = time.time()
        try:
            code, r = call(port, "POST", "/api/calibrate", {})
            self.assertEqual(code, 409)                                  
            for n in range(60):
                g = 800.0
                t_back = 35.0
                t_cell = t_back + 3 * g / 1000
                p = 0.93 * 20 * (g / 1000) * (1 - 0.004 * (t_cell - 25))
                call(port, "POST", "/api/telemetry", dict(device_id="t", ts=base + n, v=18.0, i=p / 18.0, temp_c=t_back, lux=g * 120))
            code, r = call(port, "POST", "/api/calibrate", {})
            self.assertEqual(code, 200)
            self.assertAlmostEqual(r["k_cal"], 0.93, places=3)
            self.assertAlmostEqual(call(port, "GET", "/api/status")[1]["k_cal"], 0.93, places=3)
        finally:
            srv.shutdown(); srv.server_close()
            site.db.close()
        srv2, site2, port2 = start(db=path)                              
        try:
            self.assertAlmostEqual(site2.cfg.k_cal, 0.93, places=3)
        finally:
            srv2.shutdown(); srv2.server_close()


class ExplainTests(unittest.TestCase):
    facts = dict(status="WARNING", findings=[dict(code="soiling", severity="WARNING", title="Gradual loss consistent with dust/soiling",
                                                  action="Clean the panels.", loss_amd_per_day=120.0,
                                                  evidence=dict(cleaning_breakeven_days=45.0, clean_now=0.0))],
                 ledger=dict(bill_savings_amd=1000.0, sunsync_value_amd=200.0))

    def setUp(self):
        backend._explain_cache.clear()
        os.environ.pop("ANTHROPIC_API_KEY", None)

    def test_template_fallback_without_key(self):
        out = backend.explain(self.facts, "en")
        self.assertEqual(out["source"], "template")
        self.assertIn("not urgent", out["text"])
        self.assertIn("1,000", out["text"])

    def test_request_is_built_correctly(self):
        req = backend.build_ai_request(self.facts, "ru", "KEY", "some-model")
        self.assertEqual(req.full_url, "https://api.anthropic.com/v1/messages")
        self.assertEqual(req.get_method(), "POST")
        h = {k.lower(): v for k, v in req.header_items()}
        self.assertEqual(h["x-api-key"], "KEY")
        self.assertEqual(h["anthropic-version"], "2023-06-01")
        self.assertEqual(h["content-type"], "application/json")
        body = json.loads(req.data)
        self.assertEqual(body["model"], "some-model")
        self.assertIn("Russian", body["messages"][0]["content"])
        self.assertIn("Do not invent", body["system"])
        self.assertNotIn("KEY", req.data.decode())          

    def test_ai_path_parses_response_and_falls_back_on_error(self):
        os.environ["ANTHROPIC_API_KEY"] = "KEY"
        real = urllib.request.urlopen

        class Resp:
            def __init__(self, payload): self.p = payload
            def read(self): return json.dumps(self.p).encode()
            def __enter__(self): return self
            def __exit__(self, *a): return False

        try:
            urllib.request.urlopen = lambda req, timeout=0: Resp({"content": [{"type": "text", "text": "Mocked explanation."}]})
            self.assertEqual(backend.explain(self.facts, "en")["source"], "claude")
            backend._explain_cache.clear()

            def boom(req, timeout=0):
                raise urllib.error.URLError("offline")
            urllib.request.urlopen = boom
            out = backend.explain(self.facts, "en")
            self.assertEqual(out["source"], "template")
            self.assertIn("ai_error", out)
        finally:
            urllib.request.urlopen = real
            os.environ.pop("ANTHROPIC_API_KEY", None)

if __name__ == "__main__":
    unittest.main()
